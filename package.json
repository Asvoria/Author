{
  "name": "jekyll-theme-so-simple",
  "description": "A simple Jekyll theme for words and pictures.",
  "version": "3.2.0",
  "author": "Michael Rose",
  "homepage": "http://mmistakes.github.io/so-simple-theme/",
  "repository": {
    "type": "git",
    "url": "git://github.com/mmistakes/so-simple-theme.git"
  },
  "bugs": {
    "url": "https://github.com/mmistakes/so-simple-theme/issues"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal",
    "responsive"
  ],
  "license": "MIT",
  "engines": {
    "node": ">= 16.0.0"
  },
  "devDependencies": {
    "terser": "^5.31.0",
    "chokidar-cli": "^3.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead"
  ],
  "scripts": {
    "build:js": "terser assets/js/plugins/lity.js assets/js/plugins/table-of-contents.js assets/js/main.js --compress --mangle --output assets/js/main.min.js --source-map",
    "watch:js": "chokidar \"assets/js/**/*.js\" --initial -c \"npm run build:js\"",
    "build": "npm run build:js",
    "watch": "npm run watch:js"
  },
  "dependencies": {
    "feedparser": "^2.2.10"
  }
}
